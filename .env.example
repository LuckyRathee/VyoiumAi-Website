# Copy to .env.local (git-ignored) and start with:
#   node --env-file=.env.local server.mjs
# The server does not load .env files automatically. Never commit real values.

# SMTP delivery for website enquiries
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=website@example.com
ENQUIRY_TO=hello@example.com
# true for implicit TLS (defaults to true on port 465)
# SMTP_SECURE=false
# STARTTLS is required unless set to false
# SMTP_REQUIRE_TLS=true

# Canonical origin: allowed form origin and canonical URLs at build time
SITE_URL=http://localhost:4321

# Standalone server
PORT=4321
HOST=127.0.0.1
# Enquiry attempts per ten minutes per socket address
RATE_LIMIT=6
